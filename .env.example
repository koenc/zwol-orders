# ==============================================================================
# Westlandse Bierbrouwerij ZWOL - Orders App (.env)
# ==============================================================================

# --- Flask Server ---
FLASK_ENV=production
SECRET_KEY=zwol-orders-super-secret-key-change-in-production
PORT=8503

# --- MariaDB 10 (Synology NAS) ---
# Database naam is 'zwol'. MariaDB 10 op Synology luistert standaard op 3307.
# Als DB_HOST leeggelaten wordt, schakelt de app automatisch over op lokaal SQLite.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=zwol
DB_USER=ketelhuis
DB_PASSWORD=HeinekenStinkt123#
DB_TABLE_PREFIX=ordersystem_

# --- SilvaSoft API ---
SILVASOFT_USERNAME=info@brouwerijzwol.nl
SILVASOFT_API_KEY=jouw_silvasoft_api_key_hier
SILVASOFT_BASE_URL=https://rest-api.silvasoft.nl/rest

# --- Authenticatie & Cloudflare Access ---
# Toegestane e-maildomein voor inloggen
AUTH_DOMAIN=brouwerijzwol.nl
# Op 'true' zetten tijdens lokaal ontwikkelen om login te omzeilen
AUTH_BYPASS_FOR_DEV=false

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=jouw_cloudflare_tunnel_token_hier
